# ==========================================
# SMART QUIZ PLATFORM - ENVIRONMENT CONFIG
# ==========================================

NODE_ENV=development

# Telegram Bot sozlamalari (@BotFather dan olingan token)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_USERNAME=smartquiz_bot

# Ma'lumotlar bazasi (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_quiz_platform?schema=public"

# Redis keshlash va background job navbatlari (BullMQ)
REDIS_URL="redis://127.0.0.1:6379"

# API va Veb server portlari
API_PORT=4000
WEB_PORT=3000

# Ommaviy URL manzillari (Mini App va API ulanishlari uchun)
PUBLIC_API_URL="http://localhost:4000"
PUBLIC_WEB_URL="http://localhost:3000"

# Telegram Webhook sozlamalari (Ishlab chiqishda bo'sh qoldirilsa, Long Polling ishlaydi)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Super Administrator Telegram ID raqamlari (vergul bilan ajratilgan)
SUPER_ADMIN_TELEGRAM_IDS=123456789,987654321

# Majburiy obuna kanallari (vergul bilan ajratilgan, masalan: @kanalim, https://t.me/kanalim)
# Bo'sh qoldirilsa, obuna tekshirilmaydi. Botni ushbu kanalga admin qilib qo'yish kerak!
REQUIRED_CHANNELS=

# Xavfsizlik va JWT kaliti
JWT_SECRET=smart_quiz_platform_ultra_secure_jwt_secret_key_2026_xyz

# Fayllarni saqlash yo'llari
MEDIA_STORAGE_PATH="./storage/media"
TEMP_STORAGE_PATH="./storage/temp"

# Import chegaralari
MAX_DOCX_SIZE_MB=20
MAX_IMPORT_QUESTIONS=500
